# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# busqueda_internet (proveedor: Tavily - https://tavily.com)
TAVILY_API_KEY=

# consultar_api_externa usa OpenRuc (https://openruc.com) - endpoint fijo sin
# autenticacion, no requiere variables de entorno.

# Observabilidad (opcional) - trazas de cada ejecucion del agente en LangSmith
# https://smith.langchain.com - dejar vacio para no enviar datos a un servicio externo
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=demo-ia
